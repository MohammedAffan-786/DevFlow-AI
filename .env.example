# ==============================================================================
# DEVFLOW AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core System
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug

# MongoDB Replica Set Configuration
MONGO_URI=mongodb://localhost:27017/devflow?replicaSet=rs0
MONGO_INITDB_ROOT_USERNAME=devflow_admin
MONGO_INITDB_ROOT_PASSWORD=devflow_secret_password

# Redis Distributed Message Broker
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cryptographic Tokens & Session Security
JWT_ACCESS_SECRET=replace_with_256_bit_cryptographically_secure_random_hex_string
JWT_REFRESH_SECRET=replace_with_another_256_bit_secure_random_hex_string
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes_256_gcm_storage_encryption

# GitHub App Integration Credentials
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret
# Provide GitHub App private key as a PEM string or base64 encoded string
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Internal Python AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=replace_with_shared_secret_for_internal_mTLS_auth

# Ollama Cloud
OLAMA_API_KEY=replace_with_ollama_api_key
OLAMA_BASE_URL=https://ollama.com
OLAMA_MODEL=qwen3-coder:480b-cloud

# Sandbox & Container Execution Controller
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_GID=999
SANDBOX_PYTHON_IMAGE=devflow-sandbox-python:latest
SANDBOX_NODE_IMAGE=devflow-sandbox-node:latest
SANDBOX_MAX_CONCURRENCY=4
SANDBOX_TIMEOUT_MS=20000
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_CPU_QUOTA=1.0
SANDBOX_PIDS_LIMIT=64
