FROM node:22-alpine AS builder

WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json
COPY workers/job-processor/package.json workers/job-processor/package.json
COPY workers/execution-engine/package.json workers/execution-engine/package.json
RUN pnpm install --filter @devflow/api... --frozen-lockfile

COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @devflow/shared build && pnpm --filter @devflow/api build

FROM node:22-alpine AS runner

WORKDIR /workspace
ENV NODE_ENV=production

COPY --from=builder /workspace/package.json package.json
COPY --from=builder /workspace/node_modules node_modules
COPY --from=builder /workspace/packages/shared packages/shared
COPY --from=builder /workspace/apps/api/package.json apps/api/package.json
COPY --from=builder /workspace/apps/api/node_modules apps/api/node_modules
COPY --from=builder /workspace/apps/api/dist apps/api/dist

USER node
CMD ["node", "apps/api/dist/worker.js"]
