{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "pnpm install --filter @devflow/web... --frozen-lockfile",
      "buildCommand": "pnpm --filter @devflow/shared build && pnpm --filter @devflow/web build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "apps/api/src/server.ts",
      "installCommand": "pnpm install --filter @devflow/api... --frozen-lockfile",
      "buildCommand": "pnpm --filter @devflow/shared build && pnpm --filter @devflow/api build",
      "bindings": [
        {
          "type": "service",
          "service": "ai",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ]
    },
    "ai": {
      "root": "ai-service",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "daemons": {
    "job-worker": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel-worker",
      "command": ["node", "apps/api/dist/worker.js"],
      "instances": {
        "iad1": 1
      },
      "bindings": [
        {
          "type": "service",
          "service": "ai",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
