{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "pnpm --dir ../.. install",
      "buildCommand": "pnpm --dir ../.. --filter @devflow/shared build && pnpm --dir ../.. --filter @devflow/web exec vite build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
