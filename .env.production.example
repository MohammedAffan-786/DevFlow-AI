# ==============================================================================
# DevFlow AI: Production Environment Configuration Reference
# ==============================================================================
# IMPORTANT:
# - NEVER commit populated .env files or secret keys into version control.
# - In production, inject secrets via AWS Secrets Manager, HashiCorp Vault,
#   GCP Secret Manager, or encrypted CI/CD secrets.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://app.devflow.ai

# Database (MongoDB Replica Set with TLS in production)
MONGO_URI=mongodb://mongodb:27017/devflow?replicaSet=rs0
MONGO_INITDB_ROOT_USERNAME=devflow_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_mongo_password_64char

# Redis (Queue & Caching Store)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password_64char

# Cryptographic Tokens & JWT Security (MUST BE >= 32 characters)
JWT_ACCESS_SECRET=replace_with_secure_random_base64_secret_key_at_least_32_bytes
JWT_REFRESH_SECRET=replace_with_secure_random_base64_refresh_key_at_least_32_bytes

# AI Microservice Internal Secret Authentication
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_INTERNAL_KEY=replace_with_secure_shared_ai_internal_token_32_bytes

# Large Language Model Provider API Keys
ANTHROPIC_API_KEY=sk-ant-prod-key-placeholder
OPENAI_API_KEY=sk-openai-prod-key-placeholder

# GitHub App Integration
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.placeholder_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GITHUB_WEBHOOK_SECRET=replace_with_strong_webhook_hmac_secret_key
# The PEM encoded RSA private key for the GitHub App (escaped newlines with \n)
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# Container Sandbox Execution Tuning
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_EXECUTION_TIMEOUT_SECONDS=15
SANDBOX_PIDS_LIMIT=64

# Backup & Retention
BACKUP_S3_BUCKET=devflow-backups-production
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
