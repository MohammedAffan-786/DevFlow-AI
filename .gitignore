# ==============================================================================
# DevFlow AI: Production DevSecOps .gitignore
# Strictly prevents secret leakage, environment files, build artifacts & logs
# ==============================================================================

# Secrets & Environment Configuration (NEVER COMMIT)
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.rsa

# Node & Package Manager
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs & Bundles
dist/
build/
out/
.next/
*.tsbuildinfo

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
.coverage
htmlcov/
.pytest_cache/

# Databases & Runtime State
*.sqlite
*.sqlite3
*.db
mongo_data/
redis_data/
/backups/

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.log
logs/

# Ephemeral Sandboxes
tmp/
/sandbox_tmp/
